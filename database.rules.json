{
  "rules": {
    ".read": false,
    ".write": false,
    "games": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((data.exists() && data.child('meta/host').val() === auth.uid) || (!data.exists() && newData.child('meta/host').val() === auth.uid))",
        ".validate": "$code.matches(/^[A-Z0-9]{4}$/)",
        "meta": {
          ".validate": "newData.hasChildren(['host', 'status', 'endsAt', 'steal', 'shield']) && newData.child('host').val() === auth.uid && newData.child('status').val().matches(/^(lobby|open|ended)$/)"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('games').child($code).child('meta').exists()",
            ".validate": "newData.hasChildren(['t', 'at']) && newData.child('t').val().matches(/^[ab]$/) && newData.child('at').val() === now"
          }
        },
        "cells": {
          "$z": {
            ".write": "auth != null && newData.exists() && root.child('games').child($code).child('meta/status').val() === 'open' && now < root.child('games').child($code).child('meta/endsAt').val() && newData.child('by').val() === auth.uid && newData.child('t').val() === root.child('games').child($code).child('players').child(auth.uid).child('t').val() && (!data.exists() || (data.child('t').val() !== newData.child('t').val() && root.child('games').child($code).child('meta/steal').val() === true && now > data.child('at').val() + root.child('games').child($code).child('meta/shield').val()))",
            ".validate": "$z.matches(/^([1-9]|[1-9][0-9]|10[0-9]|11[0-8])$/) && newData.hasChildren(['t', 'by', 'at']) && newData.child('at').val() === now",
            "$other": {
              ".validate": "$other === 't' || $other === 'by' || $other === 'at'"
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "quizzes": {
      "$id": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('owners').child($id).child(auth.uid).exists()",
        ".validate": "$id.matches(/^[a-z0-9]{10}$/) && newData.hasChild('title')",
        "title": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "updated": {
          ".validate": "newData.val() === now"
        },
        "qs": {
          "$i": {
            ".validate": "$i.matches(/^([0-9]|[12][0-9])$/)",
            "text": {
              ".validate": "newData.isString() && newData.val().length <= 1000"
            },
            "label": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "img": {
              ".validate": "newData.isString() && newData.val().length <= 600000 && (newData.val() === '' || newData.val().beginsWith('data:image/'))"
            },
            "ready": {
              ".validate": "newData.isBoolean()"
            },
            "opts": {
              "$j": {
                ".validate": "$j.matches(/^[0-9]$/) && newData.isString() && newData.val().length <= 300"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "answers": {
      "$id": {
        ".read": "auth != null && root.child('owners').child($id).child(auth.uid).exists()",
        ".write": "auth != null && ((!data.exists() && newData.child('k').isString() && newData.child('k').val().length >= 20) || (root.child('owners').child($id).child(auth.uid).exists() && newData.child('k').val() === data.child('k').val()))",
        "k": {
          ".validate": "newData.isString()"
        },
        "a": {
          "$i": {
            ".validate": "$i.matches(/^([0-9]|[12][0-9])$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 9"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "owners": {
      "$id": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && newData.val() === root.child('answers').child($id).child('k').val()"
        }
      }
    },
    "runs": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((data.exists() && data.child('meta/host').val() === auth.uid) || (!data.exists() && newData.child('meta/host').val() === auth.uid))",
        ".validate": "$code.matches(/^[A-Z0-9]{4}$/)",
        "meta": {
          ".validate": "newData.hasChildren(['host', 'quiz', 'status', 'endsAt']) && newData.child('host').val() === auth.uid && newData.child('status').val().matches(/^(lobby|open|ended)$/) && root.child('quizzes').child(newData.child('quiz').val()).exists()"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('runs').child($code).child('meta').exists()",
            ".validate": "newData.hasChildren(['t', 'at']) && newData.child('t').val().matches(/^[ab]$/) && newData.child('at').val() === now"
          }
        },
        "pts": {
          "$q": {
            ".validate": "$q.matches(/^([0-9]|[12][0-9])$/)",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.child('t').val() === root.child('runs').child($code).child('players').child(auth.uid).child('t').val() && root.child('proofs').child($code).child(auth.uid).child($q).exists() && root.child('runs').child($code).child('meta/status').val() === 'open' && now < root.child('runs').child($code).child('meta/endsAt').val() + 5000",
              ".validate": "newData.hasChildren(['t', 'at']) && newData.child('t').val().matches(/^[ab]$/) && newData.child('at').val() === now",
              "$other": {
                ".validate": "$other === 't' || $other === 'at'"
              }
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "proofs": {
      "$code": {
        ".write": "auth != null && root.child('runs').child($code).child('meta/host').val() === auth.uid && !newData.exists()",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$q": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('runs').child($code).child('players').child($uid).exists() && root.child('runs').child($code).child('meta/status').val() === 'open' && now < root.child('runs').child($code).child('meta/endsAt').val() && newData.child('a').val() === root.child('answers').child(root.child('runs').child($code).child('meta/quiz').val()).child('a').child($q).val()",
            ".validate": "newData.hasChildren(['a', 'at']) && newData.child('at').val() === now"
          }
        }
      }
    }
  }
}